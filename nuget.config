<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local feed built from a koras-connect-sdk checkout: run eng/build-sdk-feed.sh (or .ps1). -->
    <add key="koras-sdk-local" value="artifacts/sdk-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="koras-sdk-local"><package pattern="Koras.Connect*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
